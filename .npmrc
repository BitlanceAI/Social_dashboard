# Must live at the workspace ROOT.
#
# Adding `workspaces` to package.json makes npm ignore per-package .npmrc files
# ("npm warn config ignoring workspace config at client/.npmrc"), so the flag
# client/.npmrc used to carry has to be here instead.
#
# Why it is needed: react-helmet-async@2.0.5 declares peer react
# "^16.6.0 || ^17.0.0 || ^18.0.0" and this project is on React 19. It works
# fine at runtime; the package is simply unmaintained and never widened the
# range. React 19 hoists <title>/<meta> natively, so the real fix is dropping
# react-helmet-async entirely -- until then, this keeps installs resolving.
legacy-peer-deps=true
