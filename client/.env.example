# API Configuration
VITE_API_BASE_URL=http://localhost:3001
VITE_API_URL=http://localhost:3001

# Supabase — project URL + public anon key (safe for the browser).
# Supabase Dashboard > Project Settings > API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web push (Firebase Cloud Messaging) — optional.
# Firebase Console > Project settings > General > Your apps > Web app.
# VAPID key: Cloud Messaging > Web Push certificates > Generate key pair.
# Leave empty and the notification opt-in simply does not render.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
